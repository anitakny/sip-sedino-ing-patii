{
  "entities": {
    "Review": {
      "title": "Review",
      "description": "Komentar dan ulasan pengunjung untuk destinasi wisata di Kabupaten Pati.",
      "type": "object",
      "properties": {
        "nama": {
          "type": "string",
          "description": "Nama penulis komentar.",
          "minLength": 1,
          "maxLength": 80
        },
        "asal": {
          "type": "string",
          "description": "Kota atau daerah asal pengunjung.",
          "minLength": 1,
          "maxLength": 80
        },
        "destinasi": {
          "type": "string",
          "description": "Nama destinasi wisata Pati yang diulas.",
          "minLength": 1,
          "maxLength": 120
        },
        "rating": {
          "type": "integer",
          "description": "Nilai bintang kunjungan dari 1 sampai 5."
        },
        "tanggal": {
          "type": "string",
          "description": "Tanggal tampilan komentar.",
          "minLength": 1,
          "maxLength": 40
        },
        "komentar": {
          "type": "string",
          "description": "Isi komentar atau ulasan asli pengunjung.",
          "minLength": 5,
          "maxLength": 1000
        },
        "rekomendasi": {
          "type": "boolean",
          "description": "Apakah pengunjung merekomendasikan destinasi (rating >= 4)."
        },
        "helpfulCount": {
          "type": "integer",
          "description": "Jumlah tanda membantu dari pengunjung lain."
        },
        "editTokenHash": {
          "type": "string",
          "description": "Hash SHA-256 (64 karakter hex) dari token kepemilikan penulis.",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp server saat komentar dibuat."
        },
        "editedAt": {
          "type": "string",
          "description": "Tanggal tampilan saat komentar terakhir diedit.",
          "minLength": 1,
          "maxLength": 40
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp server saat komentar diperbarui."
        }
      },
      "required": [
        "nama",
        "asal",
        "destinasi",
        "rating",
        "tanggal",
        "komentar",
        "rekomendasi",
        "helpfulCount",
        "editTokenHash",
        "createdAt"
      ]
    },
    "ReviewProof": {
      "title": "ReviewProof",
      "description": "Dokumen tulis-saja berisi token pembuktian penulis untuk verifikasi atomik edit atau hapus komentar.",
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "description": "Token rahasia penulis (minimal 16 karakter) yang hash SHA-256-nya dicocokkan dengan editTokenHash.",
          "minLength": 16,
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp server saat aksi pembuktian dikirim."
        }
      },
      "required": ["token", "updatedAt"]
    },
    "Media": {
      "title": "Media",
      "description": "Dokumentasi foto dan video kontribusi wisatawan di galeri Cerita & Dokumentasi Sedina ing Pati.",
      "type": "object",
      "properties": {
        "judul": {
          "type": "string",
          "description": "Judul foto atau video dokumentasi wisata.",
          "minLength": 1,
          "maxLength": 120
        },
        "keterangan": {
          "type": "string",
          "description": "Cerita singkat atau keterangan dokumentasi.",
          "minLength": 1,
          "maxLength": 1000
        },
        "tipe": {
          "type": "string",
          "enum": ["foto", "video"],
          "description": "Jenis media dokumentasi (foto atau video)."
        },
        "url": {
          "type": "string",
          "description": "Tautan gambar/video atau data URL terkompresi.",
          "minLength": 5,
          "maxLength": 450000
        },
        "thumbnailUrl": {
          "type": "string",
          "description": "Tautan gambar pratinjau/thumbnail opsional.",
          "minLength": 5,
          "maxLength": 250000
        },
        "penulis": {
          "type": "string",
          "description": "Nama wisatawan atau kontributor.",
          "minLength": 1,
          "maxLength": 80
        },
        "lokasi": {
          "type": "string",
          "description": "Lokasi destinasi di Kabupaten Pati.",
          "minLength": 1,
          "maxLength": 120
        },
        "tanggal": {
          "type": "string",
          "description": "Tanggal tampilan unggahan.",
          "minLength": 1,
          "maxLength": 40
        },
        "likes": {
          "type": "integer",
          "description": "Jumlah suka dari pengunjung."
        },
        "tags": {
          "type": "array",
          "description": "Daftar tagar singkat dokumentasi (maksimal 10 tagar).",
          "maxItems": 10,
          "items": {
            "type": "string",
            "maxLength": 40
          }
        },
        "editTokenHash": {
          "type": "string",
          "description": "Hash SHA-256 (64 karakter hex) dari token kepemilikan kontributor.",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp server saat dokumentasi ditambahkan."
        },
        "editedAt": {
          "type": "string",
          "description": "Tanggal tampilan saat dokumentasi terakhir diedit.",
          "minLength": 1,
          "maxLength": 40
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp server saat dokumentasi diperbarui."
        }
      },
      "required": [
        "judul",
        "keterangan",
        "tipe",
        "url",
        "penulis",
        "lokasi",
        "tanggal",
        "likes",
        "editTokenHash",
        "createdAt"
      ]
    },
    "MediaProof": {
      "title": "MediaProof",
      "description": "Dokumen tulis-saja berisi token pembuktian kontributor untuk verifikasi atomik edit atau hapus media.",
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "description": "Token rahasia kontributor (minimal 16 karakter) yang hash SHA-256-nya dicocokkan dengan editTokenHash.",
          "minLength": 16,
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp server saat aksi pembuktian dikirim."
        }
      },
      "required": ["token", "updatedAt"]
    }
  },
  "firestore": {
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Koleksi publik komentar dan ulasan pengunjung yang dapat dibaca bersama di semua perangkat."
    },
    "/reviewProofs/{reviewId}": {
      "schema": { "$ref": "#/entities/ReviewProof" },
      "description": "Koleksi tulis-saja untuk verifikasi kepemilikan saat mengedit atau menghapus komentar."
    },
    "/media/{mediaId}": {
      "schema": { "$ref": "#/entities/Media" },
      "description": "Koleksi publik dokumentasi foto dan video wisata kontribusi pengguna Sedina ing Pati."
    },
    "/mediaProofs/{mediaId}": {
      "schema": { "$ref": "#/entities/MediaProof" },
      "description": "Koleksi tulis-saja untuk verifikasi kepemilikan saat mengedit atau menghapus media."
    }
  }
}
